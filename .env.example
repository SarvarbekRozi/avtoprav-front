# Backend API ning ildiz manzili (oxirida slash bo'lmasin).
# Frontend bu manzilga "/api" qo'shib so'rov yuboradi.
NUXT_PUBLIC_API_BASE=https://admin.avtoprav.uz

# Google Sign-In (Google Cloud Console → OAuth 2.0 Client ID, "Web application").
# Bo'sh qoldirilsa Google tugmasi umuman ko'rsatilmaydi.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Telegram Login Widget / Mini App. Bot @BotFather'da "/setdomain" bilan
# saytga bog'langan bo'lishi shart.
NUXT_PUBLIC_TELEGRAM_BOT_NAME=avtoprav_auto_bot
NUXT_PUBLIC_TELEGRAM_BOT_ID=8707751023
